from sinhvien import (
    them_sinh_vien,
    hien_thi_sinh_vien,
    tim_sinh_vien,
    xoa_sinh_vien,
    sua_sinh_vien,
)

MENU = """
===== QUAN LY SINH VIEN =====
1. Them sinh vien
2. Hien thi danh sach
3. Tim sinh vien theo ma
4. Xoa sinh vien theo ma
5. Sua thong tin sinh vien
0. Thoat
=============================
"""

CHUC_NANG = {
    "1": them_sinh_vien,
    "2": hien_thi_sinh_vien,
    "3": tim_sinh_vien,
    "4": xoa_sinh_vien,
    "5": sua_sinh_vien,
}


def main():
    while True:
        print(MENU)
        lua_chon = input("Chon chuc nang: ").strip()
        if lua_chon == "0":
            print("Tam biet!")
            break
        ham = CHUC_NANG.get(lua_chon)
        if ham:
            ham()
        else:
            print("Lua chon khong hop le, vui long chon lai.")


if __name__ == "__main__":
    main()
